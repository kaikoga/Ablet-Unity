<?xml version="1.0" encoding="utf-8"?>
<engine:UXML
    xmlns:engine="UnityEngine.UIElements"
    xmlns:aeditor="Ablet.Loch.UIElements.AEditor"
>
    <engine:Label name="isCompilingLabel" text="設定を更新中なのでしばらく待ってね" />
    <engine:ScrollView name="container">
        <engine:VisualElement class="section ndmf" name="presetsContainer">
            <aeditor:Heading text="一括設定" />
            <engine:Button name="presetPreferAbletButton" text="Ablet 優先設定" />
            <engine:Label parse-escape-sequences="true" text="Abletをメインで利用します。\nNDMF専用プラグインをAbletの上で互換動作させます。\nハイブリッドプラグインはAbletプラグインとして動作します。\nビルドはAbletから行ってください。" style="white-space: normal;" />
            <engine:Button name="presetPreferNdmfButton" text="NDMF 優先設定" />
            <engine:Label parse-escape-sequences="true" text="NDMFをメインで利用します。\nAblet専用プラグインをNDMFの上で互換動作させます。\nハイブリッドプラグインはNDMFプラグインとして動作します。\nビルドはNDMFから行ってください。" style="white-space: normal;" />
        </engine:VisualElement>
        <engine:VisualElement class="section" name="generalContainer">
            <aeditor:Heading text="全体設定" />
            <engine:VisualElement class="field">
                <engine:Toggle name="abletPreferNdmfToggle" text="Ablet Prefer NDMF" />
                <engine:Label parse-escape-sequences="true" text="オンの場合、NDMFの機能を使用する設定になります。Abletの同等の機能は非表示になります。" style="white-space: normal;" />
            </engine:VisualElement>
        </engine:VisualElement>
        <engine:VisualElement class="section" name="persistedContainer">
            <aeditor:Heading text="保存される設定" />
            <engine:VisualElement class="field forAblet">
                <engine:Toggle name="applyOnPlayToggle" text="Apply on Play" />
                <engine:Label parse-escape-sequences="true" text="プレイモードに遷移した際、AbletのApply on Playを適用します。" style="white-space: normal;" />
                <engine:Label class="ndmf" parse-escape-sequences="true" text="オンの場合、NDMFのApply on Playは無効化されます。" style="white-space: normal;" />
            </engine:VisualElement>
            <engine:VisualElement class="field forAblet">
                <engine:Toggle name="applyOnPlatformBuildToggle" text="Apply on Platform Build" />
                <engine:Label parse-escape-sequences="true" text="プラットフォームへのエクスポートを行う際、AbletのApply on Platform Buildを適用します。" style="white-space: normal;" />
                <engine:Label class="ndmf" parse-escape-sequences="true" text="オンの場合、NDMFのApply on Buildは無効化されます。" style="white-space: normal;" />
            </engine:VisualElement>
            <engine:VisualElement class="field">
                <engine:Toggle name="autoOpenConsoleWindowToggle" text="Auto Open Console Window" />
                <engine:Label parse-escape-sequences="true" text="オンの場合、Abletのコンソールが更新された際に自動的に表示します。" style="white-space: normal;" />
            </engine:VisualElement>
        </engine:VisualElement>
        <engine:VisualElement class="section ndmf" name="persistedNdmfContainer">
            <aeditor:Heading text="保存される設定 (NDMF)" />
            <engine:VisualElement class="field">
                <engine:Toggle name="abletOnNdmfToggle" text="Ablet on NDMF" />
                <engine:Label parse-escape-sequences="true" text="NDMFからAblet専用プラグインを呼び出します。" style="white-space: normal;" />
            </engine:VisualElement>
            <engine:VisualElement name="ndmfOnAbletContainer" class="field forAblet">
                <engine:Toggle name="ndmfOnAbletToggle" text="NDMF on Ablet" />
                <engine:Label parse-escape-sequences="true" text="AbletからNDMF専用プラグインを呼び出します。" style="white-space: normal;" />
                <engine:Label name="ndmfOnAbletDisabledLabel" parse-escape-sequences="true" text="NDMFのApply on Playが有効なので、NDMF on Abletを有効にできません。" style="white-space: normal;" />
            </engine:VisualElement>
            <engine:VisualElement name="preferAbletContainer" class="field forAblet">
                <engine:Toggle name="preferAbletToggle" text="Prefer Ablet" />
                <engine:Label parse-escape-sequences="true" text="Ablet NDMFハイブリッドプラグインの動作を設定します。\nオンの場合、Abletプラグインとして動作します。\nオフの場合、NDMFプラグインとして動作します。" style="white-space: normal;" />
            </engine:VisualElement>
            <engine:VisualElement name="syncTranslationContainer" class="field">
                <engine:Toggle name="syncTranslationToggle" text="Sync Translation (Loch) with NDMF" />
                <engine:Label parse-escape-sequences="true" text="オンの場合、NDMFの言語設定を適用します。" style="white-space: normal;" />
                <aeditor:LanguageSelector />
            </engine:VisualElement>
        </engine:VisualElement>
        <engine:VisualElement class="section" name="temporaryContainer">
            <aeditor:Heading text="一時的な設定" />
            <engine:VisualElement class="field">
                <engine:Toggle name="enhanceInplacePreviewToggle" text="Enhance Inplace Preview" />
                <engine:Label parse-escape-sequences="true" text="AbletのInplace Previewを行う際、一部のAbletプラグインの編集を適用します。" style="white-space: normal;" />
            </engine:VisualElement>
        </engine:VisualElement>
        <engine:IMGUIContainer name="imgui" />
    </engine:ScrollView>
</engine:UXML>