<?xml version="1.0" encoding="utf-8"?>
<engine:UXML
    xmlns:engine="UnityEngine.UIElements"
    xmlns:aeditor="Ablet.Loch.UIElements.AEditor"
>
    <engine:VisualElement class="header">
        <engine:Label name="entrypointDisplayNameText" />
        <engine:VisualElement class="row">
            <aeditor:ObjectField type="UnityEditor.SceneAsset, UnityEditor.CoreModule" label="" name="entrypointSceneAssetField" />
            <engine:Label name="entrypointScenePathText" />
        </engine:VisualElement>
        <engine:VisualElement name="noEntrypointObjectContainer" class="row">
            <aeditor:Label name="noEntrypointMessageLabel" text="Entrypoint not found" />
            <aeditor:Button name="openSceneButton" text="Open Scene" />
            <aeditor:Button name="openSceneAdditiveButton" text="Open Scene Additive" />
        </engine:VisualElement>
        <engine:VisualElement name="entrypointObjectContainer">
            <aeditor:ObjectField type="UnityEngine.GameObject, UnityEngine.CoreModule" label="Entrypoint" name="entrypointObjectField" />
        </engine:VisualElement>
    </engine:VisualElement>
    <engine:VisualElement name="resultContainer" />
    <engine:VisualElement name="noActionsContainer">
        <aeditor:Label text="Entrypoint not found"/>
    </engine:VisualElement>
    <engine:VisualElement name="actionsContainer">
        <aeditor:Button name="manualApplyButton" text="Manual Apply" />
        <engine:VisualElement name="exportUIContainer" />
    </engine:VisualElement>
</engine:UXML>